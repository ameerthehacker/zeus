{
    "name": "zeus-vscode",
    "displayName": "Zeus",
    "description": "Language support for Zeus programming language",
    "version": "0.0.1",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ameerthehacker/zeus"
    },
    "publisher": "ameerthehacker",
    "license": "MIT",
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:zeus"
    ],
    "contributes": {
        "languages": [
            {
                "id": "zeus",
                "aliases": [
                    "Zeus",
                    "zeus"
                ],
                "extensions": [
                    ".zs"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "zeus",
                "scopeName": "source.zeus",
                "path": "./syntaxes/zeus.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Zeus",
            "properties": {
                "zeus.executablePath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Zeus executable. If not set, 'zeus' from PATH will be used."
                }
            }
        },
        "commands": [
            {
                "command": "zeus.restartLanguageServer",
                "title": "Zeus: Restart Language Server"
            }
        ],
        "configurationDefaults": {
            "[zeus]": {
                "editor.defaultFormatter": "ameerthehacker.zeus-vscode",
                "editor.formatOnSave": true
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "generate-vsix": "vsce pack --out dist",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "vsix": "vsce package -o ./vsix/zeus-vscode.vsix",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@types/mocha": "^10.0.8",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^8.7.0",
        "@typescript-eslint/parser": "^8.7.0",
        "eslint": "^9.11.1",
        "typescript": "^5.6.2",
        "ts-loader": "^9.5.1",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "@vscode/vsce": "3.9.2"
    }
}
