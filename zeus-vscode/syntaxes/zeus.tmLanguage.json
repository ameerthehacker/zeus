{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "zeus",
    "patterns": [
        {
            "comment": "Declaration name: `class Foo` / `interface Foo` highlights Foo as a type",
            "match": "\\b(class|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "storage.type.zeus" },
                "2": { "name": "entity.name.type.zeus" }
            }
        },
        {
            "comment": "Inheritance clause: `extends Base` / `implements Iface` highlights the type name",
            "match": "\\b(extends|implements)\\s+([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.zeus" },
                "2": { "name": "entity.name.type.zeus" }
            }
        },
        {
            "name": "keyword.control.zeus",
            "match": "\\b(if|else|return|while|for|break|continue|new|class|interface|extends|implements|private|protected|public|this|super|try|throw|catch|finally)\\b"
        },
        {
            "name": "storage.type.zeus",
            "match": "\\b(type|function|extern)\\b"
        },
        {
            "name": "storage.modifier.zeus",
            "match": "\\b(let|const|readonly|static|get|set)\\b"
        },
        {
            "name": "constant.numeric.zeus",
            "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
            "name": "constant.boolean.zeus",
            "match": "\\b(true|false)\\b"
        },
        {
            "name": "string.quoted.double.zeus",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.zeus",
                    "match": "\\\\."
                }
            ]
        },
        {
            "name": "string.template.zeus",
            "begin": "`",
            "end": "`",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.string.template.begin.zeus" }
            },
            "endCaptures": {
                "0": { "name": "punctuation.definition.string.template.end.zeus" }
            },
            "patterns": [
                {
                    "name": "constant.character.escape.zeus",
                    "match": "\\\\."
                },
                {
                    "name": "meta.template.expression.zeus",
                    "begin": "\\$\\{",
                    "end": "\\}",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.template-expression.begin.zeus" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.template-expression.end.zeus" }
                    },
                    "patterns": [
                        { "include": "$self" }
                    ]
                }
            ]
        },
        {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.zeus"
                }
            }
        },
        {
            "name": "comment.line.double-slash.zeus",
            "match": "//.*$"
        },
        {
            "name": "support.type.zeus",
            "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|boolean|void|string|null)\\b"
        },
        {
            "name": "keyword.control.import.zeus",
            "match": "\\b(import)\\b"
        },
        {
            "name": "keyword.control.from.zeus",
            "match": "\\b(from)\\b"
        },
        {
            "name": "keyword.control.export.zeus",
            "match": "\\b(export)\\b"
        },
        {
            "match": "import\\s*({[^}]*})\\s*from\\s*(['\"][^'\"]*['\"])",
            "captures": {
                "1": {
                    "name": "variable.other.zeus"
                },
                "2": {
                    "name": "string.quoted.single.zeus"
                }
            }
        },
        {
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
            "name": "variable.other.zeus"
        }
    ],
    "scopeName": "source.zeus"
}
