---
const github = 'https://github.com/ameerthehacker/zeus';
const year = new Date().getFullYear();

const docLinks = [
  { label: 'Why Zeus?', href: '/why-zeus/' },
  { label: 'Installation', href: '/getting-started/installation/' },
  { label: 'Language Guide', href: '/language/variables/' },
  { label: 'Classes & OOP', href: '/language/classes/' },
  { label: 'Benchmarks', href: '/performance/benchmarks/' },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Zeus home">
        <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M18 2L6 16H14L12 30L26 12H17L18 2Z" fill="#facc15" stroke="#fbbf24" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
        <span>Zeus</span>
      </a>
      <p class="tagline">TypeScript's soul. Native speed.</p>
      <span class="alpha">Alpha — under active development</span>
    </div>

    <nav class="footer-links" aria-label="Documentation">
      {docLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="footer-right">
      <a href={github} class="footer-gh" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
        GitHub
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">© {year} Zeus. Built with LLVM.</div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-grad-b);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr auto;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text);
  }

  .tagline {
    margin: 0.8rem 0 0.6rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .alpha {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-links a {
    color: var(--text-dim);
    font-size: 0.92rem;
    transition: color 0.15s ease;
    width: fit-content;
  }
  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-gh {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--text-dim);
    font-size: 0.9rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .footer-gh:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-block: 1.2rem;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 46rem) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
  }
</style>
