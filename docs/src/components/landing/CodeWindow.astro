---
// Editor + terminal mockup. Always dark-themed (like a real editor) in both
// site themes. The terminal command types itself out on scroll-into-view.
---

<div class="code-window" role="img" aria-label="Editor showing hello.zs greeting by name with a template string, and a terminal running zeus run hello.zs which prints: Hello world, I'm Zeus 👋!">
  <!-- window chrome -->
  <div class="titlebar">
    <span class="dot dot-r"></span>
    <span class="dot dot-y"></span>
    <span class="dot dot-g"></span>
  </div>
  <div class="tabstrip">
    <div class="tab active">
      <svg width="13" height="13" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M18 2L6 16H14L12 30L26 12H17L18 2Z" fill="#facc15" />
      </svg>
      <span>hello.zs</span>
    </div>
  </div>

  <!-- editor pane -->
  <div class="editor">
    <div class="gutter">
      <span>1</span><span>2</span>
    </div>
    <pre class="code"><code><span class="k">let</span> <span class="v">name</span> <span class="p">=</span> <span class="s">"Zeus"</span>
<span class="fn">console</span><span class="p">.</span><span class="fn2">log</span><span class="p">(</span><span class="s">`Hello world, I'm </span><span class="p">$&#123;</span><span class="v">name</span><span class="p">&#125;</span><span class="s"> 👋!`</span><span class="p">)</span></code></pre>
  </div>

  <!-- terminal pane -->
  <div class="terminal" data-terminal>
    <div class="term-title">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="4 17 10 11 4 5" />
        <line x1="12" y1="19" x2="20" y2="19" />
      </svg>
      <span>zeus — bash</span>
    </div>
    <div class="term-body">
      <div class="term-line">
        <span class="prompt">$</span>
        <span class="cmd" data-cmd></span><span class="cur cmd-cur" data-cmd-cur></span>
      </div>
      <div class="out" data-out hidden>Hello world, I'm Zeus 👋!</div>
      <div class="term-line next" data-next hidden>
        <span class="prompt">$</span>
        <span class="cur" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .code-window {
    --win-bg: #0b1524;
    --win-bg-2: #08111d;
    --win-border: #1e3a5f;
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--win-border);
    background: var(--win-bg);
    overflow: hidden;
    box-shadow:
      0 30px 60px -20px rgba(2, 6, 23, 0.7),
      0 0 0 1px rgba(148, 163, 184, 0.04) inset;
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem 0.7rem;
    background: #0a1320;
  }

  .tabstrip {
    display: flex;
    padding: 0 0.7rem;
    background: #0a1320;
    border-bottom: 1px solid var(--win-border);
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.75rem;
    font-size: 0.76rem;
    color: #93a1b5;
    border: 1px solid transparent;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }

  .tab.active {
    color: #e6edf6;
    background: var(--win-bg);
    border-color: var(--win-border);
    border-bottom-color: var(--win-bg);
    margin-bottom: -1px;
  }

  .editor {
    display: flex;
    padding: 0.9rem 0;
    background: var(--win-bg);
  }

  .gutter {
    display: flex;
    flex-direction: column;
    padding: 0 0.9rem;
    color: #3f5069;
    text-align: right;
    user-select: none;
  }
  .gutter span { line-height: 1.7; }

  .code {
    margin: 0;
    padding: 0 1rem 0 0;
    overflow-x: auto;
    color: #c9d4e3;
  }
  .code code { line-height: 1.7; }
  .ln { display: block; }

  /* syntax tokens (brand-tinted) */
  .c { color: #5b6b82; font-style: italic; }
  .k { color: #ff7b72; }
  .v { color: #cdd9e5; }
  .fn { color: #22d3ee; }
  .fn2 { color: #facc15; }
  .s { color: #86efac; }
  .p { color: #7d8da3; }

  .terminal {
    background: var(--win-bg-2);
    border-top: 1px solid var(--win-border);
  }

  .term-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    color: #64748b;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(30, 58, 95, 0.5);
  }

  .term-body {
    padding: 0.9rem 1rem 1.1rem;
    min-height: 5.5rem;
  }

  .term-line {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #e6edf6;
  }

  .prompt {
    color: #22d3ee;
    font-weight: 600;
  }

  .cmd {
    white-space: pre;
  }

  .out {
    color: #86efac;
    padding: 0.15rem 0 0.35rem 0;
  }
  .out[hidden],
  .next[hidden] {
    display: none;
  }

  .cur {
    display: inline-block;
    width: 0.55rem;
    height: 1.05rem;
    background: #facc15;
    translate: 0 0.16rem;
    animation: blink 1.05s steps(1) infinite;
  }
  .cmd-cur {
    margin-left: 1px;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cur {
      animation: none;
    }
  }

  /* Light theme: adapt the window to the site's light mode */
  :global(:root[data-theme='light']) .code-window {
    --win-bg: #ffffff;
    --win-bg-2: #f6f8fa;
    --win-border: #d8dee4;
    box-shadow: 0 24px 50px -26px rgba(15, 40, 71, 0.22);
  }
  :global(:root[data-theme='light']) .titlebar,
  :global(:root[data-theme='light']) .tabstrip {
    background: #eceff3;
  }
  :global(:root[data-theme='light']) .tab {
    color: #6e7781;
  }
  :global(:root[data-theme='light']) .tab.active {
    color: #1f2328;
    background: var(--win-bg);
    border-color: var(--win-border);
    border-bottom-color: var(--win-bg);
  }
  :global(:root[data-theme='light']) .gutter {
    color: #b9c0c8;
  }
  :global(:root[data-theme='light']) .code {
    color: #1f2328;
  }
  :global(:root[data-theme='light']) .c { color: #6e7781; }
  :global(:root[data-theme='light']) .k { color: #cf222e; }
  :global(:root[data-theme='light']) .v { color: #1f2328; }
  :global(:root[data-theme='light']) .fn { color: #0550ae; }
  :global(:root[data-theme='light']) .fn2 { color: #8250df; }
  :global(:root[data-theme='light']) .s { color: #0a7d33; }
  :global(:root[data-theme='light']) .p { color: #57606a; }
  :global(:root[data-theme='light']) .term-title {
    color: #6e7781;
    border-bottom-color: #e2e8f0;
  }
  :global(:root[data-theme='light']) .term-line {
    color: #1f2328;
  }
  :global(:root[data-theme='light']) .prompt {
    color: #0550ae;
  }
  :global(:root[data-theme='light']) .out {
    color: #0a7d33;
  }
  :global(:root[data-theme='light']) .cur {
    background: #eab308;
  }
</style>

<script>
  const CMD = 'zeus run hello.zs';

  function runTyping(root: HTMLElement) {
    const cmdEl = root.querySelector<HTMLElement>('[data-cmd]');
    const cmdCur = root.querySelector<HTMLElement>('[data-cmd-cur]');
    const outEl = root.querySelector<HTMLElement>('[data-out]');
    const nextEl = root.querySelector<HTMLElement>('[data-next]');
    if (!cmdEl || !outEl || !nextEl) return;

    const finish = () => {
      cmdCur?.style.setProperty('display', 'none');
      outEl.hidden = false;
      nextEl.hidden = false;
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      cmdEl.textContent = CMD;
      finish();
      return;
    }

    let i = 0;
    const tick = () => {
      cmdEl.textContent = CMD.slice(0, i);
      i += 1;
      if (i <= CMD.length) {
        window.setTimeout(tick, 55 + Math.random() * 45);
      } else {
        window.setTimeout(finish, 450);
      }
    };
    tick();
  }

  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((el) => {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runTyping(el);
            obs.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    io.observe(el);
  });
</script>
