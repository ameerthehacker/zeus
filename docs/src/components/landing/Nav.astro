---
const github = 'https://github.com/ameerthehacker/zeus';
const docs = '/getting-started/installation/';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Zeus home">
      <svg class="bolt" width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path
          d="M18 2L6 16H14L12 30L26 12H17L18 2Z"
          fill="url(#nav-bolt)"
          stroke="#fbbf24"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <defs>
          <linearGradient id="nav-bolt" x1="6" y1="2" x2="26" y2="30" gradientUnits="userSpaceOnUse">
            <stop stop-color="#fef08a" />
            <stop offset="0.5" stop-color="#facc15" />
            <stop offset="1" stop-color="#eab308" />
          </linearGradient>
        </defs>
      </svg>
      <span class="brand-name">Zeus</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href={docs} class="nav-link nav-link--desktop">Docs</a>
      <a href={github} class="nav-link" target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
      </a>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <a href={docs} class="btn btn-primary nav-cta">Get started</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .bolt {
    filter: drop-shadow(0 0 10px rgba(250, 204, 21, 0.45));
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle .icon-sun {
    display: none;
  }
  .theme-toggle .icon-moon {
    display: block;
  }
  :global(:root[data-theme='light']) .theme-toggle .icon-sun {
    display: block;
  }
  :global(:root[data-theme='light']) .theme-toggle .icon-moon {
    display: none;
  }

  .nav-cta {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 40rem) {
    .nav-link--desktop,
    .nav-cta {
      display: none;
    }
    .brand-name {
      font-size: 1.15rem;
    }
  }
</style>

<script>
  const KEY = 'starlight-theme';

  function apply(theme: string) {
    document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
  }

  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const next = current === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    apply(next);
  });
</script>
