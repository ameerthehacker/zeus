---
const features = [
  {
    title: 'Familiar TypeScript syntax',
    body: 'Classes, interfaces, generics, and type annotations that read like TypeScript. If you know TS, you already know most of Zeus.',
    icon: 'ts',
  },
  {
    title: 'Native LLVM binaries',
    body: 'Compiles straight to a small, self-contained native executable via LLVM. No interpreter, no VM, instant startup.',
    icon: 'bolt',
  },
  {
    title: 'Batteries-included stdlib',
    body: 'fs, os, path, json, crypto, datetime, and a test runner ship in the box — Node/TS parity without the npm sprawl.',
    icon: 'stdlib',
  },
  {
    title: 'Approachable by design',
    body: 'A rich type system with no borrow checker to fight and no ceremony to wade through — the sweet spot between Rust and Go.',
    icon: 'approach',
  },
];
---

<section class="features">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Why Zeus?</p>
      <h2 class="section-title">TypeScript's ergonomics, compiled to a native binary.</h2>
      <p class="section-sub">
        Zeus is a new language that keeps what's great about TypeScript, drops JavaScript's
        dynamism, and compiles to native code — an approachable systems language that sits
        between Rust's power and Go's simplicity.
      </p>
    </div>

    <div class="grid">
      {
        features.map((f) => (
          <article class="card">
            <span class="card-icon">
              {f.icon === 'ts' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <path d="M8 12h5M10.5 12v5M15 16.5c.5.5 1.2.8 2 .8 1.1 0 1.8-.6 1.8-1.4 0-1.9-3.4-1.2-3.4-3 0-.8.7-1.4 1.7-1.4.7 0 1.3.2 1.7.6" />
                </svg>
              )}
              {f.icon === 'bolt' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" />
                </svg>
              )}
              {f.icon === 'stdlib' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" />
                </svg>
              )}
              {f.icon === 'approach' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z" />
                  <path d="M2 21c0-3 1.85-5.36 5.08-6" />
                </svg>
              )}
            </span>
            <h3 class="card-title">{f.title}</h3>
            <p class="card-body">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .section-head {
    max-width: 40rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .kicker {
    margin: 0 0 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
  }

  .section-title {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    color: var(--text);
  }

  .section-sub {
    margin: 1rem 0 0;
    color: var(--text-dim);
    font-size: 1.02rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }

  .card {
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: 0 16px 40px -14px rgba(234, 179, 8, 0.22);
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    color: var(--zeus-yellow-400);
    background: rgba(234, 179, 8, 0.1);
    border: 1px solid rgba(234, 179, 8, 0.22);
  }
  :global(:root[data-theme='light']) .card-icon {
    color: var(--zeus-yellow-600);
  }

  .card-title {
    font-size: 1.08rem;
    margin-bottom: 0.4rem;
    color: var(--text);
  }

  .card-body {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-dim);
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 34rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
